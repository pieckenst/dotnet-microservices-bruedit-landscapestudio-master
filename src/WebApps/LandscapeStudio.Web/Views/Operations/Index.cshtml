@model OperationListViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["Section"] = Model.Title;
    var resources = new[] {
        ("plants", "Plant catalog"), ("materials", "Materials"), ("work-types", "Work types"),
        ("suppliers", "Suppliers"), ("stock-items", "Inventory"), ("purchase-orders", "Purchase orders"),
        ("deliveries", "Deliveries")
    };
}
<div class="page-heading page-heading-compact">
    <div><span class="eyebrow"><span class="eyebrow-line"></span> OPERATIONS</span><h1>@Model.Title <span>workspace.</span></h1><p>This table is populated from the configured gateway; unavailable data is shown as an error, never fabricated as sample records.</p></div>
</div>
<div class="resource-tabs">
    @foreach (var resource in resources)
    {
        <a class="@(string.Equals(Model.Resource, resource.Item1, StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-action="Index" asp-route-resource="@resource.Item1">@resource.Item2</a>
    }
</div>
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-error" role="alert"><strong>Service request failed.</strong> @Model.Error</div>
}
<section class="surface-card">
    <div class="section-heading section-heading-table"><div><span class="mini-kicker">CONNECTED SERVICE DATA</span><h2>@Model.Title</h2><p>@Model.Items.Count.ToString("N0") record(s) returned by the current request.</p></div><span class="gateway-status"><span class="status-dot"></span>Gateway</span></div>
    @if (Model.Items.Count > 0 && Model.Columns.Count > 0)
    {
        <div class="table-wrap"><table><thead><tr>@foreach (var column in Model.Columns) { <th>@column</th> }</tr></thead><tbody>
        @foreach (var item in Model.Items)
        {
            <tr>@foreach (var column in Model.Columns) { <td>@(item.Values.TryGetValue(column, out var value) ? value : "—")</td> }</tr>
        }
        </tbody></table></div>
        <div class="table-footer"><span>Displaying records returned by the API.</span></div>
    }
    else if (string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="empty-state"><span class="empty-illustration">⌕</span><h3>No records returned</h3><p>The service returned no rows for this request. New entries and editing workflows will be added alongside each endpoint's validated contract.</p></div>
    }
</section>

@model ProfilePageViewModel
@{
    ViewData["Title"] = "Profile";
    ViewData["Section"] = "Profile";
}
<div class="page-heading page-heading-compact">
    <div><span class="eyebrow"><span class="eyebrow-line"></span> YOUR ACCOUNT</span><h1>Profile &amp; <span>preferences.</span></h1><p>Contact data and workspace preferences belong to Account. Credentials, roles and sign-in remain in Identity.</p></div>
</div>
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-error" role="alert"><strong>Account service unavailable.</strong> @Model.Error</div>
}
@if (Model.Errors.Count > 0)
{
    <div class="alert alert-error" role="alert">@foreach (var error in Model.Errors) { <div>@error</div> }</div>
}
<div asp-validation-summary="All" class="validation-summary"></div>
<div class="profile-grid">
    <section class="surface-card form-section">
        <div class="form-section-heading"><span class="form-step">01</span><div><h2>Contact information</h2><p>Saved to your Account profile, separate from login credentials.</p></div></div>
        <form asp-action="UpdateProfile" method="post" class="form-stack">
            @Html.AntiForgeryToken()
            <div class="field"><label for="DisplayName">Display name <span class="required">*</span></label><input id="DisplayName" name="DisplayName" value="@Model.Profile?.DisplayName" maxlength="120" required /></div>
            <div class="form-grid">
                <div class="field"><label for="FirstName">First name</label><input id="FirstName" name="FirstName" value="@Model.Profile?.FirstName" maxlength="80" /></div>
                <div class="field"><label for="LastName">Last name</label><input id="LastName" name="LastName" value="@Model.Profile?.LastName" maxlength="80" /></div>
            </div>
            <div class="field"><label for="Email">Email</label><input id="Email" name="Email" type="email" value="@Model.Profile?.Email" maxlength="254" /></div>
            <div class="form-grid">
                <div class="field"><label for="PhoneNumber">Phone number</label><input id="PhoneNumber" name="PhoneNumber" type="tel" value="@Model.Profile?.PhoneNumber" maxlength="40" /></div>
                <div class="field"><label for="CompanyName">Company</label><input id="CompanyName" name="CompanyName" value="@Model.Profile?.CompanyName" maxlength="160" /></div>
            </div>
            <div class="form-actions form-actions-start"><button class="button button-primary" type="submit">Save profile <span aria-hidden="true">→</span></button></div>
        </form>
    </section>
    <section class="surface-card form-section">
        <div class="form-section-heading"><span class="form-step">02</span><div><h2>Workspace preferences</h2><p>Your defaults affect your experience, not your Identity credentials.</p></div></div>
        <form asp-action="UpdatePreferences" method="post" class="form-stack">
            @Html.AntiForgeryToken()
            <div class="field"><label for="Theme">Appearance</label><select id="Theme" name="Theme"><option value="system" selected="@(Model.Preferences?.Theme == "system" ? "selected" : null)">System default</option><option value="light" selected="@(Model.Preferences?.Theme == "light" ? "selected" : null)">Light</option><option value="dark" selected="@(Model.Preferences?.Theme == "dark" ? "selected" : null)">Dark</option></select></div>
            <div class="field"><label for="Language">Language</label><select id="Language" name="Language"><option value="en" selected="@(Model.Preferences?.Language == "en" ? "selected" : null)">English</option><option value="ru" selected="@(Model.Preferences?.Language == "ru" ? "selected" : null)">Русский</option><option value="be" selected="@(Model.Preferences?.Language == "be" ? "selected" : null)">Беларуская</option></select></div>
            <div class="field"><label for="TimeZone">Time zone identifier</label><input id="TimeZone" name="TimeZone" value="@(Model.Preferences?.TimeZone ?? "UTC")" maxlength="80" required /><small>Example: UTC, Europe/Minsk, Europe/Amsterdam.</small></div>
            <label class="toggle-line"><input type="checkbox" name="EmailNotificationsEnabled" value="true" checked="@(Model.Preferences?.EmailNotificationsEnabled == true ? "checked" : null)" /><span><strong>Email notifications</strong><small>Receive operational updates by email.</small></span></label>
            <input type="hidden" name="EmailNotificationsEnabled" value="false" />
            <label class="toggle-line"><input type="checkbox" name="SmsNotificationsEnabled" value="true" checked="@(Model.Preferences?.SmsNotificationsEnabled == true ? "checked" : null)" /><span><strong>SMS notifications</strong><small>Receive selected updates by SMS where configured.</small></span></label>
            <input type="hidden" name="SmsNotificationsEnabled" value="false" />
            <div class="form-actions form-actions-start"><button class="button button-primary" type="submit">Save preferences <span aria-hidden="true">→</span></button></div>
        </form>
    </section>
</div>
<section class="surface-card form-section address-section">
    <div class="form-section-heading"><span class="form-step">03</span><div><h2>Addresses</h2><p>Manage service, project and contact addresses for your Account profile.</p></div></div>
    @if (Model.Addresses.Count > 0)
    {
        <div class="address-list">
        @foreach (var address in Model.Addresses)
        {
            <article class="address-card">
                <div class="address-card-heading"><span class="address-label-icon">⌂</span><div><strong>@address.Label</strong><small>@(address.IsDefault ? "Default address" : "Saved address")</small></div>
                    @if (address.IsDefault) { <span class="status-pill">DEFAULT</span> }
                </div>
                <form asp-action="UpdateAddress" asp-route-id="@address.Id" method="post" class="form-stack address-edit-form">
                    @Html.AntiForgeryToken()
                    <div class="form-grid">
                        <div class="field"><label for="Label-@address.Id">Label</label><input id="Label-@address.Id" name="Label" value="@address.Label" required maxlength="80" /></div>
                        <div class="field"><label for="Line1-@address.Id">Address line 1</label><input id="Line1-@address.Id" name="Line1" value="@address.Line1" required maxlength="160" /></div>
                        <div class="field"><label for="Line2-@address.Id">Address line 2</label><input id="Line2-@address.Id" name="Line2" value="@address.Line2" maxlength="160" /></div>
                        <div class="field"><label for="City-@address.Id">City</label><input id="City-@address.Id" name="City" value="@address.City" required maxlength="100" /></div>
                        <div class="field"><label for="Region-@address.Id">Region</label><input id="Region-@address.Id" name="Region" value="@address.Region" maxlength="100" /></div>
                        <div class="field"><label for="PostalCode-@address.Id">Postal code</label><input id="PostalCode-@address.Id" name="PostalCode" value="@address.PostalCode" maxlength="24" /></div>
                        <div class="field"><label for="Country-@address.Id">Country code</label><input id="Country-@address.Id" name="Country" value="@address.Country" required minlength="2" maxlength="2" /></div>
                        <div class="field field-checkbox"><label class="toggle-line"><input type="checkbox" name="IsDefault" value="true" checked="@(address.IsDefault ? "checked" : null)" /><span><strong>Set as default</strong><small>Use this as the default Account address.</small></span></label><input type="hidden" name="IsDefault" value="false" /></div>
                    </div>
                    <div class="address-actions"><button class="button button-secondary" type="submit">Save address</button></div>
                </form>
                <form asp-action="DeleteAddress" asp-route-id="@address.Id" method="post" class="address-delete-form">
                    @Html.AntiForgeryToken()
                    <button class="button button-danger button-small" type="submit" onclick="return confirm('Delete this saved address?');">Delete address</button>
                </form>
            </article>
        }
        </div>
    }
    else
    {
        <div class="compact-empty"><span>⌂</span><strong>No saved addresses</strong><p>Add a contact or service address below. Addresses are stored against your Account profile.</p></div>
    }
</section>
<section class="surface-card form-section address-section">
    <div class="form-section-heading"><span class="form-step">04</span><div><h2>Add an address</h2><p>Country must be an ISO-style two-letter code, such as BY or NL.</p></div></div>
    <form asp-action="CreateAddress" method="post" class="form-stack">
        @Html.AntiForgeryToken()
        <div class="form-grid">
            <div class="field"><label for="NewLabel">Label <span class="required">*</span></label><input id="NewLabel" name="Label" placeholder="Home, office, project site" required maxlength="80" /></div>
            <div class="field"><label for="NewLine1">Address line 1 <span class="required">*</span></label><input id="NewLine1" name="Line1" required maxlength="160" /></div>
            <div class="field"><label for="NewLine2">Address line 2</label><input id="NewLine2" name="Line2" maxlength="160" /></div>
            <div class="field"><label for="NewCity">City <span class="required">*</span></label><input id="NewCity" name="City" required maxlength="100" /></div>
            <div class="field"><label for="NewRegion">Region</label><input id="NewRegion" name="Region" maxlength="100" /></div>
            <div class="field"><label for="NewPostalCode">Postal code</label><input id="NewPostalCode" name="PostalCode" maxlength="24" /></div>
            <div class="field"><label for="NewCountry">Country code <span class="required">*</span></label><input id="NewCountry" name="Country" value="BY" required minlength="2" maxlength="2" /></div>
            <div class="field field-checkbox"><label class="toggle-line"><input type="checkbox" name="IsDefault" value="true" /><span><strong>Set as default</strong><small>Make this the default address.</small></span></label><input type="hidden" name="IsDefault" value="false" /></div>
        </div>
        <div class="form-actions form-actions-start"><button class="button button-primary" type="submit">Add address <span aria-hidden="true">→</span></button></div>
    </form>
</section>
<div class="profile-footnote"><span class="lock-mark">◇</span><span><strong>Security separation</strong><small>This screen cannot change passwords, roles or sign-in status. Manage those through the Identity service.</small></span></div>

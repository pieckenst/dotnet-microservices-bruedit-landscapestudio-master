{
  "Routes": [
    //Transaction API
    {
      "DownstreamPathTemplate": "/api/v1/Transactions/{accountId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "transaction.api",
          "Port": "8080"
        }
      ],
      "UpstreamPathTemplate": "/Transactions/{accountId}",
      "UpstreamHttpMethod": [ "GET" ]
    },
    {
      "DownstreamPathTemplate": "/api/v1/Transactions",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "transaction.api",
          "Port": "8080"
        }
      ],
      "UpstreamPathTemplate": "/Transactions",
      "UpstreamHttpMethod": [ "GET" ]
    },
    //Account API
    {
      "DownstreamPathTemplate": "/api/v1/Accounts",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "account.api",
          "Port": "8080"
        }
      ],
      "UpstreamPathTemplate": "/Accounts",
      "UpstreamHttpMethod": [ "POST" ]
    },
    {
      "DownstreamPathTemplate": "/api/v1/Accounts/Adding",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "account.api",
          "Port": "8080"
        }
      ],
      "UpstreamPathTemplate": "/Accounts/Adding",
      "UpstreamHttpMethod": [ "POST" ]
    },
    {
      "DownstreamPathTemplate": "/api/v1/Accounts/Withdrawing",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "account.api",
          "Port": "8080"
        }
      ],
      "UpstreamPathTemplate": "/Accounts/Withdrawing",
      "UpstreamHttpMethod": [ "POST" ]
    },
    {
      "DownstreamPathTemplate": "/api/v1/Accounts/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "account.api",
          "Port": "8080"
        }
      ],
      "UpstreamPathTemplate": "/Accounts/{id}",
      "UpstreamHttpMethod": [ "GET" ]
    },
    //Legacy Customer API retained until Project's client/reference model has been migrated.
    {
      "DownstreamPathTemplate": "/api/v1/Customers",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "customer.api",
          "Port": "8080"
        }
      ],
      "UpstreamPathTemplate": "/Customers",
      "UpstreamHttpMethod": [ "POST" ]
    },
    {
      "DownstreamPathTemplate": "/api/v1/Customers/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "customer.api",
          "Port": "8080"
        }
      ],
      "UpstreamPathTemplate": "/Customers/{id}",
      "UpstreamHttpMethod": [ "GET" ]
    },
    //Catalog resource/item routes must be separate so the optional id segment is preserved.
    {
      "DownstreamPathTemplate": "/api/v1/{resource}/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "catalog.api",
          "Port": "8080"
        }
      ],
      "UpstreamPathTemplate": "/Catalog/{resource}/{id}",
      "UpstreamHttpMethod": [ "GET", "PUT", "DELETE" ]
    },
    {
      "DownstreamPathTemplate": "/api/v1/{resource}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "catalog.api",
          "Port": "8080"
        }
      ],
      "UpstreamPathTemplate": "/Catalog/{resource}",
      "UpstreamHttpMethod": [ "GET", "POST" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:8010"
  }
}

{
  "DatabaseSettings": {
    "ConnectionString": "mongodb://analyticsdb:27017",
    "DatabaseName": "LandscapeAnalytics",
    "CollectionName": "AuditEvents"
  },
  "Jwt": {
    "Issuer": "LandscapeStudio.Identity",
    "Audience": "LandscapeStudio.Clients"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "EventBusSettings": {
    "HostAddress": "amqp://guest:guest@rabbitmq:5672"
  },
  "AllowedHosts": "*"
}
